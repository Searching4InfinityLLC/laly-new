# Payload (added in the Payload phase)
MONGODB_URL=mongodb://127.0.0.1/laly-web
PAYLOAD_SECRET=change-me
BLOB_READ_WRITE_TOKEN=
# Seed-only. `ADMIN_PASSWORD=... bun run seed` creates or rotates the /admin login. Never set in
# Vercel — nothing reads it at runtime, and it would sit in the dashboard as a plaintext credential.
ADMIN_PASSWORD=

# ISR on-demand revalidation
REVALIDATE_SECRET=change-me

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_META_PIXEL_ID=

# --- Booking dialog -------------------------------------------------------------------------
# Agency zone for slot labels (the dialog converts for the visitor). See src/lib/slots.ts.
BOOKING_TZ=America/New_York
# Fallback open hours when Google is unset, OR when a day has no `[Available]` events on the
# calendar. Lunch (12:00–13:00 agency-local) is skipped only on this fallback path.
BOOKING_OPEN_HOUR=9
BOOKING_CLOSE_HOUR=17
# Title prefix for open-hours events on GOOGLE_CALENDAR_ID. Create timed or all-day events named
# e.g. "[Available]", set Show as: Free, optionally repeat weekly. Real meetings stay Busy and
# are subtracted. Days with at least one matching event use those windows instead of OPEN/CLOSE.
BOOKING_AVAILABLE_PREFIX=[Available]

# Google CALENDAR (not the Meet API — Meet v2 manages spaces and has no scheduling). See
# src/lib/google.ts. All four set -> Available windows + free/busy drive the picker, and a booking
# creates the event with a Meet link and emails the invite. Any missing -> the stub: every
# BOOKING_OPEN/CLOSE slot is offered, the lead is only logged, and the dialog does not claim an
# invite was sent.
#   ID/SECRET: GCP project laly-509023 -> Credentials -> the "Web" OAuth client.
#   REFRESH_TOKEN: `bun run google:auth`, signed in as the calendar owner. Needs
#     http://localhost:8787/oauth/callback on the client's redirect URIs, the Calendar API
#     enabled, and the consent screen in Production (in Testing the token dies after 7 days).
#   CALENDAR_ID: `primary`, or the owner's email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
