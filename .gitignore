# reference repo — not part of this project
/sia-cms

# deps — bun only; keep bun.lock committed, reject other package managers' lockfiles
/node_modules
pnpm-lock.yaml
package-lock.json
yarn.lock

# next
/.next
/out
next-env.d.ts

# local media uploads (Payload staticDir; source of truth is Atlas + scripts/seed-home.ts)
/public/media

# env — *.env catches vendor-generated credential files (Atlas's "Download .env file" lands as
# atlas-credentials.env, which matched none of the patterns below). .env.example still tracked.
.env
.env*.local
*.env

# Google OAuth client downloads (client_secret_*.json from the Cloud console, or pasted copies).
# They hold the client secret — the values belong in .env, the file in the bin.
client_secret*.json
paste_*.json

# vercel
.vercel

# browser network captures. Two of these sat in public/ at ~9 MB each, which on Vercel means
# publicly downloadable at /www.example.com.har. These two held no cookies or auth headers, but a
# HAR is a verbatim request/response dump and the next one saved from a logged-in tab would.
# Never in public/ — that directory is served as-is.
*.har

# raw video masters. public/ is served as-is, so a .mov there is a 24 MB public download nothing
# uses — the site ships the encoded .mp4 (public/whoweare/vjbrand.mp4).
*.mov

# misc
*.tsbuildinfo
.DS_Store
